  shorttitle = {Speciation Patterns in the {{{\emph{Forficula}}}}{\emph{ Auricularia}} Species Complex},
  author = {{Gonz{\'a}lez-Migu{\'e}ns}, Rub{\'e}n and {Mu{\~n}oz-Nozal}, Eva and {Jim{\'e}nez-Ruiz}, Yolanda and {Mas-Peinado}, Paloma and Ghanavi, Hamid R and {Garc{\'i}a-Par{\'i}s}, Mario},
  year = 2020,
